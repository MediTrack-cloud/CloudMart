# ── Required ─────────────────────────────────────────────────────────────────
# GitHub org/username for the GitHub Actions OIDC trust policy (IAM role)
GITHUB_ORG=your-github-org

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Uncomment to use a named AWS profile instead of the default
# AWS_PROFILE=default

# ── Optional: owner tag ──────────────────────────────────────────────────────
OWNER_EMAIL=team@cloudmart.example

# ── Optional: notifications ───────────────────────────────────────────────────
# Budget alarm, GuardDuty findings, and CloudWatch alarms will email here
ALERT_EMAIL=
# Verified SES sender address (leave empty to skip SES identity creation)
SES_FROM_EMAIL=

# ── Optional: HTTPS ──────────────────────────────────────────────────────────
# Leave empty for HTTP-only (port 80). Set to enable HTTPS via ACM.
ACM_CERT_ARN=

# ── Optional: overrides ───────────────────────────────────────────────────────
GITHUB_REPO=CloudMart-demo
MONTHLY_BUDGET_USD=30
